# Banco de dados
POSTGRES_USER=agrolink
POSTGRES_PASSWORD=agrolink
POSTGRES_DB=agrolink
DATABASE_URL=postgresql://agrolink:agrolink@db:5432/agrolink

# JWT — Gerar com: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=SUBSTITUA_POR_UMA_CHAVE_FORTE_64_CHARS
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# App
PROJECT_NAME=AgroLink API
API_V1_PREFIX=/api/v1
ENVIRONMENT=production

# CORS — origens separadas por vírgula (sem wildcard em produção)
ALLOWED_ORIGINS=https://agro-link-eight.vercel.app,https://agrolink.ao

# Admin — Gerar com: python -c "import secrets; print(secrets.token_hex(24))"
ADMIN_SETUP_KEY=SUBSTITUA_POR_UMA_CHAVE_FORTE_ADMIN

# ProxyPay Webhook — segredo partilhado com o gateway para validar HMAC
PROXYPAY_WEBHOOK_SECRET=SUBSTITUA_PELO_SECRET_DO_PROXYPAY

# Comissões (percentuais)
TRANSPORT_COMMISSION_PERCENT=5
MACHINE_RENTAL_COMMISSION_PERCENT=10
